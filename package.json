{
  "name": "econ-coach-whiteboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Handwritten economics whiteboard with an on-device Bonsai-2 AI tutor (fully local, no cloud APIs).",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "vite",
    "build": "tsc && vite build",
    "hub:cert": "sh scripts/hub-cert.sh",
    "hub": "npm run build && node scripts/hub.mjs",
    "start": "node server.js",
    "bonsai": "powershell -ExecutionPolicy Bypass -File scripts/start-bonsai.ps1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "framer-motion": "^12.15.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
